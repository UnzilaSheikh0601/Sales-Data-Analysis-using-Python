    "# Extract City from Purchase Address\n",
    "def get_city(address):\n",
    "    try:\n",
    "        parts = address.split(',')\n",
    "        # last two parts typically \"City, ST ZIP\" -> we take the city part\n",
    "        return parts[-2].strip()\n",
    "    except:\n",
    "        return address\n",
    "        \n",
    "df['City'] = df['Purchase Address'].apply(get_city)\n",
    "df.head()"
   ]
